# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/backend/.venv/
__pycache__/
*.py[cod]
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example
backend/.data/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# playwright / local test artifacts
test-results/

# local runtime and generated evaluation artifacts
/flow-server*.log
/eval/reports/baseline_*.json
/projects/


# iOS / Xcode
ios/DerivedData/
ios/build/
xcuserdata/
*.xcuserstate
