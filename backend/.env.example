EVILIFE_ENV=development

# 不要把Key提交到Git。DeepSeek使用OpenAI兼容接口。
EVILIFE_AI_ENABLED=true
DEEPSEEK_API_KEY=
EVILIFE_AI_BASE_URL=https://api.deepseek.com
EVILIFE_AI_FAST_MODEL=deepseek-v4-flash
EVILIFE_AI_DEEP_MODEL=deepseek-v4-pro
# 官方 DeepSeek 文本 API 不接收图片。视觉功能必须连接独立托管/自托管的
# OpenAI-compatible DeepSeek-VL2 服务，密钥只放部署平台环境变量。
EVILIFE_VISION_API_KEY=
EVILIFE_VISION_BASE_URL=
EVILIFE_AI_VISION_MODEL=deepseek-ai/deepseek-vl2-small

# 用户、会话、健康记录、设备聚合、报告索引和对话历史统一写入运行库。
EVILIFE_RUNTIME_DB=backend/.data/runtime.sqlite3
# 仅首次迁移旧版本JSON时填写；原文件不会删除。
EVILIFE_LIFESTYLE_STORE=
EVILIFE_AUTH_REQUIRED=true
EVILIFE_COOKIE_SECURE=false
EVILIFE_SESSION_DAYS=14
EVILIFE_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# 只读权威证据库；留空时自动发现仓库内数据库。
EVILIFE_CORPUS_DB=
EVILIFE_LIVE_SEARCH_ENABLED=true
EVILIFE_EUROPE_PMC_BASE_URL=https://www.ebi.ac.uk/europepmc/webservices/rest
EVILIFE_LIVE_SEARCH_MAX_RESULTS=4
